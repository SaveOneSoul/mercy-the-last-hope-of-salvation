APP_NAME=Mercy Catholic AI API
ENVIRONMENT=development
ALLOWED_ORIGINS=https://YOUR_GITHUB_USERNAME.github.io,http://localhost:5500,http://127.0.0.1:5500

# Gemini — server-side only. Never place this key in javascript/config.js.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite

# reCAPTCHA Enterprise. Site key is public; backend uses service-account ADC.
RECAPTCHA_ENFORCE=false
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=

# Contact persistence. Keep false on Cloud Run unless DATABASE_URL points to a durable DB.
PERSIST_CONTACT_MESSAGES=false
DATABASE_URL=sqlite:////tmp/mercy.db

OWNER_EMAIL=
OWNER_WHATSAPP=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

AUTO_REPLY_FAITH_QUESTIONS=true
MAX_CHAT_CHARS=2000
MAX_CONTACT_CHARS=5000
RATE_LIMIT_PER_MINUTE=20
