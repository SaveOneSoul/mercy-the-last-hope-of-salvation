# Core
ENVIRONMENT=development
ALLOWED_ORIGINS=https://YOUR_GITHUB_USERNAME.github.io,http://localhost:5500,http://127.0.0.1:5500

# OpenAI — server-side only. Never place this key in javascript/config.js.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_CLASSIFIER_MODEL=gpt-5.6
# Contact persistence. Keep false on Cloud Run unless DATABASE_URL points to a durable DB.
PERSIST_CONTACT_MESSAGES=false
DATABASE_URL=sqlite:////tmp/mercy.db

# Owner notifications
OWNER_EMAIL=
OWNER_WHATSAPP=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# WhatsApp Cloud API. Configure the current Meta /messages endpoint.
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

AUTO_REPLY_FAITH_QUESTIONS=true
RATE_LIMIT_PER_MINUTE=20
