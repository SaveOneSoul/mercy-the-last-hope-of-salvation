{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saveonesoul.example/schemas/logos-interlinear-token.schema.json",
  "title": "Logos Interlinear Token",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "book_id",
    "chapter",
    "verse",
    "position",
    "language",
    "surface",
    "normalized",
    "lemma",
    "transliteration",
    "gloss",
    "part_of_speech",
    "morphology",
    "text_source",
    "linguistic_source"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "book_id": {"type": "string", "minLength": 2, "maxLength": 4},
    "chapter": {"type": "integer", "minimum": 1},
    "verse": {"type": "string", "pattern": "^[0-9]+(?:[-a-z0-9]+)?$"},
    "position": {"type": "integer", "minimum": 1},
    "language": {"type": "string", "enum": ["he", "arc", "grc", "la"]},
    "surface": {"type": "string", "minLength": 1},
    "normalized": {"type": "string", "minLength": 1},
    "lemma": {"type": "string", "minLength": 1},
    "transliteration": {"type": "string"},
    "gloss": {"type": "string", "minLength": 1},
    "part_of_speech": {"type": "string", "minLength": 1},
    "morphology": {"type": "string", "minLength": 1},
    "text_source": {"type": "string", "minLength": 1},
    "linguistic_source": {"type": "string", "minLength": 1},
    "source_token_id": {"type": ["string", "null"]},
    "source_revision": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
