PORT=8080

# Local development fallback. Production Cloud Run should use the Cloud SQL
# variables below instead of SQLite.
DATABASE_URL=sqlite:///./mercy.db

# Cloud SQL PostgreSQL (production)
DB_USER=mercy_app
DB_PASS=
DB_NAME=mercy
INSTANCE_UNIX_SOCKET=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE_SECONDS=1800

CORS_ORIGINS=https://saveonesoul.github.io
PUBLIC_SITE_BASE=https://saveonesoul.github.io/mercy-the-last-hope-of-salvation
ENABLE_DOCS=true

# Admin dashboard / CMS — SERVER SIDE ONLY.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CMS_BUCKET=

# Magisterium AI — doctrinal authority for Catholic AI and the humanoid avatar.
MAGISTERIUM_API_KEY=
MAGISTERIUM_MODEL=magisterium-1
MAGISTERIUM_CHAT_URL=https://www.magisterium.com/api/v1/chat/completions
MAGISTERIUM_TIMEOUT_SECONDS=90
MAGISTERIUM_RATE_LIMIT_PER_MINUTE=8

# Mercy Humanoid Avatar — optional secondary reasoning adapter.
# Theology always routes to the Magisterium gateway. Secrets remain server-side.
AVATAR_REASONING_PROVIDER=none
# Comma-separated specialist providers. Keep empty for single-provider mode.
AVATAR_MULTI_AGENT_PROVIDERS=
AVATAR_RATE_LIMIT_PER_MINUTE=12
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_BASE_URL should be a private/authenticated backend-reachable service.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Future specialist integrations. Keep disabled until separately reviewed.
CYBERSECGPT_AVATAR_ENABLED=false
SOVEREIGN_BRAIN_AVATAR_ENABLED=false

# Optional YouTube Live integration — SERVER SIDE ONLY.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional adult AI reflection support — disabled until explicitly configured.
COUNSELLING_ENABLED=false
COUNSELLING_API_KEY=
COUNSELLING_MODEL=
